+// MARK: - Isolated sig demo backend
+
+// Generated from the desktop's public client configuration by prepare-upstream.
+// This is deliberately embedded in SignalServiceKit, which is shared by the
+// app, share extension, and notification service extension. No invites, wallet
+// seeds, inference credentials, or server private keys belong in this payload.
+public enum SigDemoRuntimeConfiguration {
+    private static let embedded = "__SIG_DEMO_CLIENT_CONFIGURATION_BASE64__"
+
+    public static var publicClientConfigurationData: Data {
+        guard let data = Data(base64Encoded: embedded) else {
+            fatalError("The private demo configuration is invalid.")
+        }
+        return data
+    }
+
+    private static let client: [String: Any] = {
+        guard let data = Data(base64Encoded: embedded),
+              let client = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+        else { fatalError("An explicit isolated sig demo backend is required.") }
+        return client
+    }()
+
+    static func string(_ key: String) -> String {
+        guard let value = client[key] as? String, !value.isEmpty else {
+            fatalError("Missing sig demo public configuration: \(key)")
+        }
+        return value
+    }
+
+    static func data(_ key: String) -> Data {
+        guard let value = Data(base64Encoded: string(key)), !value.isEmpty else {
+            fatalError("Invalid sig demo public parameters: \(key)")
+        }
+        return value
+    }
+
+    static let trustRoots: [String] = {
+        guard let roots = client["serverTrustRoots"] as? [String], !roots.isEmpty else {
+            fatalError("Missing private sig demo trust roots.")
+        }
+        return roots
+    }()
+
+    static func cdn(_ index: String) -> String {
+        guard let cdn = client["cdn"] as? [String: String], let value = cdn[index] else {
+            fatalError("Missing private sig demo CDN endpoint.")
+        }
+        return value
+    }
+
+    static var certificateDer: Data {
+        let pem = string("certificateAuthority")
+        let base64 = pem.components(separatedBy: .newlines)
+            .filter { !$0.hasPrefix("-----") }.joined()
+        guard let data = Data(base64Encoded: base64), !data.isEmpty else {
+            fatalError("Invalid private sig demo certificate.")
+        }
+        return data
+    }
+}
+
