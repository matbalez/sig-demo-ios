+/// An in-memory endpoint key with redacted Debug and zeroization on drop.
+#[derive(Clone, Debug)]
+pub struct EmbeddedClientSecretKey(iroh::SecretKey);
+
+impl PartialEq for EmbeddedClientSecretKey {
+    fn eq(&self, other: &Self) -> bool {
+        self.0.public() == other.0.public()
+    }
+}
+impl Eq for EmbeddedClientSecretKey {}
+impl EmbeddedClientSecretKey {
+    pub(crate) fn secret_key(&self) -> iroh::SecretKey {
+        self.0.clone()
+    }
+}
