+#[cfg(test)]
+mod embedded_client_identity_tests {
+    use super::*;
+
+    #[test]
+    fn only_injected_clients_own_their_identity() {
+        for (client, injected, expected) in [
+            (false, false, false),
+            (false, true, false),
+            (true, false, false),
+            (true, true, true),
+        ] {
+            assert_eq!(owns_client_identity(client, injected), expected);
+        }
+    }
+
+    #[test]
+    fn memory_mesh_names_preserve_restricted_and_legacy_paths() {
+        for client in [false, true] {
+            for injected in [false, true] {
+                for unrestricted in [false, true] {
+                    let name =
+                        client_memory_mesh_name(client, injected, unrestricted, "public-endpoint");
+                    assert_eq!(name.is_some(), client && injected && unrestricted);
+                }
+            }
+        }
+        assert_eq!(
+            client_memory_mesh_name(true, true, true, "public-endpoint"),
+            Some("embedded-client:public-endpoint".to_owned())
+        );
+        assert_ne!(
+            client_memory_mesh_name(true, true, true, "first"),
+            client_memory_mesh_name(true, true, true, "second")
+        );
+    }
+}
