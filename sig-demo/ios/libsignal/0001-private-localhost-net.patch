@@ -0,0 +1,190 @@
+//! Localhost-only demo environment, adapted from the pinned upstream test environment.
+//
+// Copyright 2024 Signal Messenger, LLC.
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+use std::net::Ipv4Addr;
+use std::num::NonZeroU16;
+
+use attest::svr2::RaftConfig;
+use libsignal_net::chat::RECOMMENDED_CHAT_WS_CONFIG;
+use libsignal_net::connect_state::ServiceName;
+use libsignal_net::enclave::{Cdsi, EnclaveEndpoint, EndpointParams, MrEnclave, SvrSgx};
+use libsignal_net::env::{ConnectionConfig, DomainConfig, Env, KeyTransConfig, Svr2Env, SvrBEnv};
+use libsignal_net::infra::RECOMMENDED_WS_CONFIG;
+use libsignal_net::infra::certs::RootCertificates;
+use libsignal_net::infra::route::HttpVersion;
+
+const ENCLAVE_ID_MOCK_SERVER: &[u8] = b"0.20240911.184407";
+
+fn localhost_demo_domain_config(
+    service: ServiceName,
+    port: NonZeroU16,
+    root_certificate_der: &[u8],
+    http_version: HttpVersion,
+) -> DomainConfig {
+    const LOCALHOST_IP_V4: Ipv4Addr = Ipv4Addr::LOCALHOST;
+    DomainConfig {
+        ip_v4: &[LOCALHOST_IP_V4],
+        ip_v6: &[],
+        connect: ConnectionConfig {
+            service,
+            hostname: "localhost",
+            port,
+            cert: RootCertificates::FromDer(std::borrow::Cow::Owned(root_certificate_der.to_vec())),
+            http_version: Some(http_version),
+            min_tls_version: None,
+            confirmation_header_name: None,
+            proxy: None,
+        },
+    }
+}
+
+pub(crate) struct LocalhostEnvPortConfig {
+    pub(crate) chat_port: NonZeroU16,
+    pub(crate) cdsi_port: NonZeroU16,
+    pub(crate) svr2_port: NonZeroU16,
+    pub(crate) svrb_port: NonZeroU16,
+}
+
+const DUMMY_RAFT_CONFIG: &RaftConfig = &RaftConfig {
+    min_voting_replicas: 3,
+    max_voting_replicas: 9,
+    super_majority: 0,
+    group_id: 17325409821474389983,
+    attestation_timeout: 604800,
+    db_version: 2,
+    simulated: false,
+};
+
+const DUMMY_CDSI_ENDPOINT_PARAMS: EndpointParams<'static, Cdsi> = EndpointParams {
+    mr_enclave: MrEnclave::new(ENCLAVE_ID_MOCK_SERVER),
+    raft_config: (),
+};
+
+const DUMMY_SVR2_ENDPOINT_PARAMS: EndpointParams<'static, SvrSgx> = EndpointParams {
+    mr_enclave: MrEnclave::new(ENCLAVE_ID_MOCK_SERVER),
+    raft_config: DUMMY_RAFT_CONFIG,
+};
+
+const DUMMY_SVRB_ENDPOINT_PARAMS: EndpointParams<'static, SvrSgx> = EndpointParams {
+    mr_enclave: MrEnclave::new(ENCLAVE_ID_MOCK_SERVER),
+    raft_config: DUMMY_RAFT_CONFIG,
+};
+
+const DUMMY_KEYTRANS_CONFIG: KeyTransConfig = KeyTransConfig {
+    signing_key_material: &[0; 32],
+    vrf_key_material: &[0; 32],
+    auditor_key_material: &[&[0; 32]],
+};
+
+pub(crate) fn localhost_demo_env_with_ports(
+    ports: LocalhostEnvPortConfig,
+    root_certificate_der: &[u8],
+    http_version: HttpVersion,
+) -> Env<'static> {
+    Env {
+        chat_domain_config: localhost_demo_domain_config(
+            ServiceName("chat"),
+            ports.chat_port,
+            root_certificate_der,
+            http_version,
+        ),
+        chat_ws_config: RECOMMENDED_CHAT_WS_CONFIG,
+        cdsi: EnclaveEndpoint {
+            domain_config: localhost_demo_domain_config(
+                ServiceName("cdsi"),
+                ports.cdsi_port,
+                root_certificate_der,
+                http_version,
+            ),
+            ws_config: RECOMMENDED_WS_CONFIG,
+            params: DUMMY_CDSI_ENDPOINT_PARAMS,
+        },
+        svr2: Svr2Env {
+            current: EnclaveEndpoint {
+                domain_config: localhost_demo_domain_config(
+                    ServiceName("svr2"),
+                    ports.svr2_port,
+                    root_certificate_der,
+                    http_version,
+                ),
+                ws_config: RECOMMENDED_WS_CONFIG,
+                params: DUMMY_SVR2_ENDPOINT_PARAMS,
+            },
+            previous: None,
+        },
+        svr_b: SvrBEnv::new(
+            [
+                Some(EnclaveEndpoint {
+                    domain_config: localhost_demo_domain_config(
+                        ServiceName("svrb"),
+                        ports.svrb_port,
+                        root_certificate_der,
+                        http_version,
+                    ),
+                    ws_config: RECOMMENDED_WS_CONFIG,
+                    params: DUMMY_SVRB_ENDPOINT_PARAMS,
+                }),
+                None,
+                None,
+            ],
+            [None, None, None],
+        ),
+        keytrans_config: DUMMY_KEYTRANS_CONFIG,
+        reflector_providers: || &[],
+    }
+}
+
+/// Build no public-service route: unsupported services are confined to the closed
+/// loopback port 1 and are rejected by the Swift API before any connection.
+pub(crate) fn local_demo_env(chat_port: NonZeroU16, root_certificate_der: &[u8]) -> Env<'static> {
+    let disabled_port = NonZeroU16::new(1).expect("one is nonzero");
+    localhost_demo_env_with_ports(
+        LocalhostEnvPortConfig {
+            chat_port,
+            cdsi_port: disabled_port,
+            svr2_port: disabled_port,
+            svrb_port: disabled_port,
+        },
+        root_certificate_der,
+        HttpVersion::Http2,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_route_remains_on_loopback_with_only_the_supplied_root() {
+        let certificate = &[1, 2, 3];
+        let env = local_demo_env(NonZeroU16::new(14443).expect("nonzero"), certificate);
+        let mut domains = vec![
+            &env.chat_domain_config,
+            &env.cdsi.domain_config,
+            &env.svr2.current.domain_config,
+        ];
+        domains.extend(
+            env.svr_b
+                .current_and_previous()
+                .map(|endpoint| &endpoint.domain_config),
+        );
+        for domain in domains {
+            assert_eq!(domain.connect.hostname, "localhost");
+            assert_eq!(domain.ip_v4, &[Ipv4Addr::LOCALHOST]);
+            assert!(domain.ip_v6.is_empty());
+            assert!(domain.connect.proxy.is_none());
+            assert_eq!(domain.connect.http_version, Some(HttpVersion::Http2));
+            assert_eq!(
+                domain.connect.cert,
+                RootCertificates::FromDer(certificate.to_vec().into())
+            );
+        }
+        assert_eq!(env.chat_domain_config.connect.port.get(), 14443);
+        assert_eq!(env.cdsi.domain_config.connect.port.get(), 1);
+        assert_eq!(env.svr2.current.domain_config.connect.port.get(), 1);
+        assert!(env.svr2.previous.is_none());
+        assert!((env.reflector_providers)().is_empty());
+    }
+}
