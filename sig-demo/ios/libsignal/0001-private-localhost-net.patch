+/// Create a private localhost-only connection manager, with no public fallback.
+/// This is a normal FFI export so it is available on physical iOS devices.
+#[bridge_fn(jni = false, node = false)]
+fn ConnectionManager_new_local_demo(
+    user_agent: String,
+    chat_port: AsType<NonZeroU16, u16>,
+    root_certificate_der: &[u8],
+    remote_config: &mut BridgedStringMap,
+    build_variant: AsType<BuildVariant, u8>,
+) -> Result<ConnectionManager, IllegalArgumentError> {
+    if root_certificate_der.is_empty() || root_certificate_der.len() > 65_536 {
+        return Err(IllegalArgumentError::new(
+            "A private DER certificate is required",
+        ));
+    }
+    boring_signal::x509::X509::from_der(root_certificate_der)
+        .map_err(|_| IllegalArgumentError::new("The private DER certificate is invalid"))?;
+    let manager = ConnectionManager::new_from_isolated_environment(
+        local_demo::local_demo_env(chat_port.into_inner(), root_certificate_der),
+        &user_agent,
+        remote_config.take(),
+        build_variant.into_inner(),
+    );
+    manager.set_ipv6_enabled(false);
+    Ok(manager)
+}
