+    pub async fn with_native_prompt_counter<T>(
+        &self, name: &str, system: &str, tools: &[Tool],
+        fit: impl FnOnce(&mut dyn FnMut(&[Message]) -> Result<usize, ProviderError>) -> Result<T, ProviderError>,
+    ) -> Result<T, ProviderError> {
+        let settings = config_resolver::model_settings(name).map_err(|e| ProviderError::ExecutionError(e.to_string()))?;
+        let key = ModelCacheKey::new(LLAMACPP_BACKEND_ID, name, settings.chat_template.clone());
+        let slot = self.runtime.get_or_create_model_slot(key);
+        let mut state = slot.state.lock().await;
+        let ModelSlotState::Loaded { model, .. } = &mut *state else {
+            return Err(ProviderError::ExecutionError("GGUF is not loaded".into()));
+        };
+        let tools_json = if tools.is_empty() { None } else {
+            let specs = goose_provider_types::formats::openai::format_tools(tools)
+                .map_err(|e| ProviderError::ExecutionError(e.to_string()))?;
+            Some(serde_json::to_string(&specs).map_err(|e| ProviderError::ExecutionError(e.to_string()))?)
+        };
+        fit(&mut |messages| llamacpp::count_native_prompt(&mut **model, name, &settings, system, messages, tools_json.as_deref()))
+    }
