+/// Disabled reasoning is a presentation boundary. A later model token can close
+/// an implicit reasoning span or turn a provisional answer into a tool call.
+/// No provisional text may reach the GDK message store or the UI.
+fn generate_answer_only(
+    ctx: &mut GenerationContext<'_>,
+    mut prepared: super::inference_engine::PreparedGeneration<'_>,
+) -> Result<(), ProviderError> {
+    let mut raw = String::new();
+    let mut stops = StopSuffixTrimmer::new(&prepared.template_result.additional_stops);
+    let mut stopped = false;
+    let output_count = generation_loop(
+        &ctx.loaded.model, &mut prepared.llama_ctx, ctx.settings, prepared.prompt_token_count,
+        prepared.effective_ctx, |piece| {
+            if ctx.tx.is_closed() {
+                return Err(ProviderError::ExecutionError("Local generation cancelled".into()));
+            }
+            let (accepted, matched) = stops.push(piece);
+            raw.push_str(&accepted);
+            stopped = matched;
+            Ok(if matched { TokenAction::Stop } else { TokenAction::Continue })
+        },
+    )?;
+
+    if !stopped {
+        raw.push_str(&stops.finish());
+    }
+    // A token ceiling cannot guarantee that the model completed its channel.
+    // Still report actual usage (also used for a one-token load probe).
+    if stopped || ctx.settings.max_output_tokens.is_none_or(|limit| output_count < limit as i32) {
+        let parse = |raw: &str| -> Result<Value, ProviderError> {
+            let json = prepared.template_result.parse_response_oaicompat(raw, false)
+                .map_err(|_| ProviderError::ExecutionError("Invalid native model completion".into()))?;
+            serde_json::from_str(&json)
+                .map_err(|_| ProviderError::ExecutionError("Invalid native message".into()))
+        };
+        let content = completed_message_content(&raw, parse)?;
+        if !content.is_empty() {
+            let mut message = Message::new(rmcp::model::Role::Assistant, chrono::Utc::now().timestamp(), content);
+            message.id = Some(ctx.message_id.to_owned());
+            ctx.tx.blocking_send(Ok((Some(message), None)))
+                .map_err(|_| ProviderError::ExecutionError("Local generation cancelled".into()))?;
+        }
+    } else {
+        // GDK distinguishes token exhaustion from a naturally empty answer.
+        // Report only its terminal metadata; the unfinished model channels stay private.
+        let mut marker = Message::assistant().with_visibility(false, false);
+        marker.id = Some(ctx.message_id.to_owned());
+        marker.metadata.output_token_limit_reached = true;
+        ctx.tx.blocking_send(Ok((Some(marker), None)))
+            .map_err(|_| ProviderError::ExecutionError("Local generation cancelled".into()))?;
+    }
+
+    let usage = finalize_usage(ctx.log, std::mem::take(&mut ctx.model_name), "native",
+        prepared.prompt_token_count, output_count, None);
+    let _ = ctx.tx.blocking_send(Ok((None, Some(usage))));
+    Ok(())
+}
+
+fn completed_message_content(
+    raw: &str,
+    parse: impl Fn(&str) -> Result<Value, ProviderError>,
+) -> Result<Vec<MessageContent>, ProviderError> {
+    use goose_provider_types::thinking::{completed_answer_text, completed_answer_with_opaque_ranges};
+    let original = parse(raw)?;
+    let mut opaque = Vec::new();
+    if let Some(ranges) = original.get("native_argument_ranges").and_then(Value::as_array) {
+        for pair in ranges {
+            let range = pair.as_array().filter(|p| p.len() == 2)
+                .and_then(|p| Some(usize::try_from(p[0].as_u64()?).ok()?..usize::try_from(p[1].as_u64()?).ok()?))
+                .filter(|r| r.start < r.end && raw.get(r.clone()).is_some())
+                .ok_or_else(|| ProviderError::ExecutionError("Invalid native argument boundaries".into()))?;
+            opaque.push(range);
+        }
+    }
+    // Tool syntax inside reasoning is discarded. A reasoning delimiter inside
+    // a native argument is ordinary tool data and must survive byte-for-byte.
+    let visible_wire = completed_answer_with_opaque_ranges(raw, &opaque);
+    if visible_wire.trim().is_empty() {
+        return Ok(Vec::new());
+    }
+    let native = if visible_wire == raw { original } else { parse(&visible_wire)? };
+    // Use only the native parser's structural calls. A tool turn has no
+    // user-visible prose, even when the model narrates before making the call.
+    if let Some(calls) = native.get("tool_calls").and_then(Value::as_array).filter(|c| !c.is_empty()) {
+        let mut calls = calls.clone();
+        for (index, call) in calls.iter_mut().enumerate() {
+            let fields = call.as_object_mut().ok_or_else(||
+                ProviderError::ExecutionError("Invalid native tool call".into()))?;
+            fields.insert("index".into(), Value::from(index));
+        }
+        let requests = extract_oai_tool_call_contents(&calls);
+        if requests.len() != calls.len() {
+            return Err(ProviderError::ExecutionError("Invalid native tool call".into()));
+        }
+        return Ok(requests);
+    }
+
+    let text = completed_answer_text(native.get("content").and_then(Value::as_str).unwrap_or(""));
+    Ok(if text.trim().is_empty() { Vec::new() } else { vec![MessageContent::text(text)] })
+}
